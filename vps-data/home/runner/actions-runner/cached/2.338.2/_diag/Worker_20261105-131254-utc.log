    {
      "type": "action",
      "reference": {
        "type": "script"
      },
      "displayNameToken": {
        "type": 0,
        "file": 1,
        "line": 41,
        "col": 15,
        "lit": "Install backup/restore scripts"
      },
      "contextName": "__run_2",
      "inputs": {
        "type": 2,
        "map": [
          {
            "key": "script",
            "value": {
              "type": 0,
              "file": 1,
              "line": 42,
              "col": 14,
              "lit": "cat > /tmp/backup.sh <<'EOF'\n#!/usr/bin/env bash\n# Saves every file created/changed since the session started, anywhere on the VPS.\nset -uo pipefail\nexport LC_ALL=C\ncd \"$GITHUB_WORKSPACE\"\nDEST=\"$GITHUB_WORKSPACE/vps-data\"\nMARK=/tmp/.vps-session-start\n[ -f \"$MARK\" ] || { echo \"Session marker missing (restore did not finish); skipping backup.\"; exit 0; }\nmkdir -p \"$DEST/_meta\"\nrm -f /tmp/changed.list /tmp/skipped.list /tmp/deleted.list\n\n# 1) Find changed files. -cnewer uses ctime, so files extracted with old\n#    timestamps (unzip, tar, git clone) are still detected.\n#    Pruned: pseudo-FS, system dirs that the fresh runner image already owns\n#    (reinstall those via apt, which is tracked separately), caches, boot-time noise.\nsudo find $SCAN_ROOTS -xdev \\\n  \\( -path /proc -o -path /sys -o -path /dev -o -path /run -o -path /tmp -o -path /var/tmp \\\n     -o -path /var/log -o -path /var/cache -o -path /var/lib -o -path /boot -o -path /snap \\\n     -o -path /lost+found -o -path /bin -o -path /sbin -o -path /lib -o -path /lib32 \\\n     -o -path /lib64 -o -path /libx32 \\\n     -o \\( -path '/usr/*' ! -path /usr/local ! -path '/usr/local/*' \\) \\\n     -o -path /usr/local/bin/sshx \\\n     -o -path /home/runner/work -o -path /home/runner/runners \\\n     -o -path '/home/*/.cache' -o -path '/home/*/.npm' -o -path '/home/*/.cargo' \\\n     -o -path '/home/*/.rustup' -o -path '/home/*/.dotnet' -o -path '/home/*/.nvm' \\\n     -o -path '/home/*/.ghcup' -o -path /root/.cache -o -path /root/.npm \\\n     -o -path /opt/hostedtoolcache -o -path /opt/actionarchivecache \\\n     -o -path /opt/runner-cache -o -path /opt/post-generation \\\n     -o -path /etc/resolv.conf -o -path /etc/hosts -o -path /etc/hostname \\\n     -o -path /etc/machine-id -o -path /etc/mtab -o -path /etc/ld.so.cache \\\n     -o -path '/etc/passwd*' -o -path '/etc/shadow*' -o -path '/etc/group*' \\\n     -o -path '/etc/gshadow*' -o -path /etc/alternatives -o -path /etc/ssl/certs \\\n     -o -path '/etc/ssh/ssh_host_*' \\\n     -o -name .git -o -name __pycache__ \\) -prune -o \\\n  \\( -cnewer \"$MARK\" -type f -size +\"${MAX_MB}M\" -fprint /tmp/skipped.list \\) -o \\\n  \\( -cnewer \"$MARK\" \\( -type f -o -type l \\) -print0 \\) > /tmp/changed.list 2>/dev/null\n\n# 2) Copy them into vps-data/<absolute path>. sudo tar so root-only files are readable.\nif [ -s /tmp/changed.list ]; then\n  sudo tar --null --no-recursion -T /tmp/changed.list -cf - 2>/tmp/tar.err \\\n    | tar -xf - -C \"$DEST\" --no-same-owner\n  grep -v 'Removing leading' /tmp/tar.err | head -5 || true\nfi\n\n# 3) Propagate deletions: files we restored earlier that you have since deleted.\nif [ -s /tmp/restored.list ]; then\n  sudo bash -c 'while IFS= read -r -d \"\" f; do [ -e \"$f\" ] || [ -L \"$f\" ] || printf \"%s\\0\" \"$f\"; done' \\\n    < /tmp/restored.list > /tmp/deleted.list\n  while IFS= read -r -d '' f; do rm -f -- \"$DEST$f\"; done < /tmp/deleted.list\nfi\n\n# 4) Remember apt packages you installed this session.\nif command -v dpkg-query >/dev/null && [ -f /tmp/pkgs.base ]; then\n  dpkg-query -W -f='${binary:Package}\\n' | sort -u > /tmp/pkgs.now\n  { cat \"$DEST/_meta/apt-packages.txt\" 2>/dev/null; comm -13 /tmp/pkgs.base /tmp/pkgs.now; } \\\n    | sort -u | sed '/^$/d' > /tmp/pkgs.merged\n  if [ -s /tmp/pkgs.merged ]; then cp /tmp/pkgs.merged \"$DEST/_meta/apt-packages.txt\"; fi\nfi\n\n# 5) Be transparent about anything too big for GitHub.\nif [ -s /tmp/skipped.list ]; then\n  sort -u /tmp/skipped.list > \"$DEST/_meta/skipped-too-large.txt\"\n  echo \"WARNING: files over ${MAX_MB} MB were NOT saved:\"; cat \"$DEST/_meta/skipped-too-large.txt\"\nelse\n  rm -f \"$DEST/_meta/skipped-too-large.txt\"\nfi\n\n# 6) Commit + push. Oversized files inside the repo workspace are excluded so one\n#    giant file can't block every push. -f makes sure .gitignore can't hide vps-data.\nfind . -path ./.git -prune -o -path ./vps-data -prune -o -type f -size +95M -print \\\n  | sed 's|^\\./|/|' >> .git/info/exclude\ngit add -A\ngit add -A -f -- vps-data\nif git diff --cached --quiet; then\n  echo \"No changes to back up.\"\n  exit 0\nfi\ngit commit -qm \"Auto-backup $(date -u '+%F %T') UTC [skip ci]\"\nfor i in 1 2 3; do\n  if git push -q origin \"HEAD:${BRANCH}\"; then\n    echo \"Backup pushed to ${BRANCH}\"\n    exit 0\n  fi\n  git pull --rebase -q origin \"${BRANCH}\" || git rebase --abort\n  sleep 5\ndone\necho \"Push failed after retries; will retry next cycle.\"\nexit 1\nEOF\n\ncat > /tmp/restore.sh <<'EOF'\n#!/usr/bin/env bash\nset -uo pipefail\nexport LC_ALL=C DEBIAN_FRONTEND=noninteractive\nSRC=\"$GITHUB_WORKSPACE/vps-data\"\nME=\"$(id -un)\"\nrm -f /tmp/.vps-session-start /tmp/restored.list\n\n# Baseline of image packages BEFORE restoring yours (used to detect new installs).\nif command -v dpkg-query >/dev/null; then\n  dpkg-query -W -f='${binary:Package}\\n' | sort -u > /tmp/pkgs.base\nfi\n\nif [ -d \"$SRC\" ]; then\n  # 1) Packages first, so your restored configs overwrite package defaults.\n  if [ -s \"$SRC/_meta/apt-packages.txt\" ]; then\n    echo \"Reinstalling apt packages...\"\n    sudo apt-get update -qq || true\n    sudo xargs -a \"$SRC/_meta/apt-packages.txt\" apt-get install -y -qq \\\n      -o Dpkg::Options::=--force-confold || echo \"Some packages failed to install\"\n  fi\n\n  # 2) Files. Only files/symlinks are extracted (never directory entries), so\n  #    permissions of existing system dirs like /root are not touched.\n  (cd \"$SRC\" && find . \\( -type f -o -type l \\) ! -path './_meta/*' ! -path ./startup.sh -print0) > /tmp/restore-files.list\n  if [ -s /tmp/restore-files.list ]; then\n    tar -C \"$SRC\" --null --no-recursion -T /tmp/restore-files.list -cf - \\\n      | sudo tar -xf - -C / --no-same-owner\n    # Git doesn't keep owners: runner's home goes back to runner, the rest is root's.\n    if [ -d \"$SRC/home/runner\" ] && [ -d /home/runner ]; then\n      for e in \"$SRC\"/home/runner/* \"$SRC\"/home/runner/.[!.]*; do\n        [ -e \"$e\" ] && sudo chown -R \"$ME:$(id -gn)\" \"/home/runner/$(basename \"$e\")\"\n      done\n    fi\n    # Record what really landed on disk (used later to detect your deletions).\n    sed -z 's|^\\.||' /tmp/restore-files.list \\\n      | sudo bash -c 'while IFS= read -r -d \"\" f; do { [ -e \"$f\" ] || [ -L \"$f\" ]; } && printf \"%s\\0\" \"$f\"; done' \\\n      > /tmp/restored.list\n    echo \"Restored $(tr -cd '\\0' < /tmp/restored.list | wc -c) files.\"\n  fi\n\n  # Git only keeps the exec bit; SSH refuses keys with loose permissions.\n  fix_ssh() { [ -d \"$1\" ] && chmod 700 \"$1\" && find \"$1\" -type f ! -name '*.pub' ! -name known_hosts -exec chmod 600 {} + ; return 0; }\n  fix_ssh \"$HOME/.ssh\"\n  sudo bash -c '[ -d /root/.ssh ] && chmod 700 /root/.ssh && find /root/.ssh -type f ! -name \"*.pub\" ! -name known_hosts -exec chmod 600 {} +' || true\n\n  # 3) Optional hook for anything else (services, kernel settings...).\n  if [ -f \"$SRC/startup.sh\" ]; then\n    echo \"Running startup.sh\"\n    sudo bash \"$SRC/startup.sh\" || echo \"startup.sh exited non-zero\"\n  fi\nelse\n  echo \"No previous VPS data; fresh start.\"\nfi\n\n# Everything from here on counts as \"created in this session\". The marker is set 1s in the\n# past so files written in the first instant (coarse kernel timestamps) are never missed;\n# re-saving a just-restored file is harmless because the content is identical.\nsleep 2\ntouch -d '1 second ago' /tmp/.vps-session-start\nEOF\n\nchmod +x /tmp/backup.sh /tmp/restore.sh\n"
            }
          }
        ]
      },

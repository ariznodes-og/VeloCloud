              "col": 14,
              "lit": "git config --global user.name \"VPS Auto-Saver\"\ngit config --global user.email \"vps@autosaver.com\"\ngit config --global pull.rebase true\ngit config --global --add safe.directory \"$GITHUB_WORKSPACE\"\n"
            }
          }
        ]
      },
      "condition": "success()",
      "id": "65132df4-e516-4bcd-bd83-340b947663a6",
      "name": "__run"
    },
    {
      "type": "action",
      "reference": {
        "type": "script"
      },
      "displayNameToken": {
        "type": 0,
        "file": 1,
        "line": 40,
        "col": 15,
        "lit": "Install backup/restore scripts"
      },
      "contextName": "__run_2",
      "inputs": {
        "type": 2,
        "map": [
          {
            "key": "script",
            "value": {
              "type": 0,
              "file": 1,
              "line": 41,
              "col": 14,
              "lit": "# Scripts live outside the workspace so they never get committed.\ncat > /tmp/backup.sh <<'EOF'\n#!/usr/bin/env bash\nset -uo pipefail\ncd \"$GITHUB_WORKSPACE\"\nDEST=\"$GITHUB_WORKSPACE/vps-data\"\nmkdir -p \"$DEST\"\n\nfor p in $PERSIST_PATHS; do\n  [ -d \"$p\" ] || continue\n  mkdir -p \"$DEST$p\"\n  # Excludes: nested .git (would become broken submodules), caches, and the\n  # runner image's preinstalled toolchains/runner internals (huge, reinstallable).\n  # --max-size keeps us under GitHub's 100 MB per-file push limit.\n  sudo rsync -a --delete --max-size=50M \\\n    --chown=\"$(id -un):$(id -gn)\" \\\n    --exclude='.git/' --exclude='node_modules/' --exclude='.cache/' \\\n    --exclude='/work/' --exclude='/runners/' --exclude='/.cargo/' \\\n    --exclude='/.rustup/' --exclude='/.dotnet/' --exclude='/.nvm/' \\\n    --exclude='/.ghcup/' --exclude='/.npm/' --exclude='/.docker/' \\\n    --exclude='/.sshx/' --exclude='/hostedtoolcache/' \\\n    \"$p/\" \"$DEST$p/\" || echo \"rsync warning for $p\"\ndone\n\ngit add -A\nif git diff --cached --quiet; then\n  echo \"No changes to back up.\"\n  exit 0\nfi\n\ngit commit -qm \"Auto-backup $(date -u '+%F %T') UTC [skip ci]\"\n# Retry with rebase in case the remote moved (e.g. you pushed from your PC).\nfor i in 1 2 3; do\n  if git push -q origin \"HEAD:${BRANCH}\"; then\n    echo \"Backup pushed to ${BRANCH}\"\n    exit 0\n  fi\n  git pull --rebase -q origin \"${BRANCH}\" || git rebase --abort\n  sleep 5\ndone\necho \"Push failed after retries; will retry next cycle.\"\nexit 1\nEOF\n\ncat > /tmp/restore.sh <<'EOF'\n#!/usr/bin/env bash\nset -uo pipefail\nSRC=\"$GITHUB_WORKSPACE/vps-data\"\n[ -d \"$SRC\" ] || { echo \"No previous VPS data; fresh start.\"; exit 0; }\n\nfor p in $PERSIST_PATHS; do\n  [ -d \"$SRC$p\" ] || continue\n  owner=\"$(id -un):$(id -gn)\"; [ \"$p\" = \"/root\" ] && owner=\"root:root\"\n  # No --delete: never wipe files the fresh runner image needs.\n  sudo mkdir -p \"$p\"\n  sudo rsync -a --chown=\"$owner\" \"$SRC$p/\" \"$p/\"\n  echo \"Restored $p\"\ndone\n\n# Git only tracks the exec bit; SSH refuses keys with loose permissions.\nfix_ssh() {\n  [ -d \"$1\" ] || return 0\n  chmod 700 \"$1\"\n  find \"$1\" -type f ! -name '*.pub' ! -name known_hosts -exec chmod 600 {} +\n}\nfix_ssh \"$HOME/.ssh\"\nsudo bash -c '[ -d /root/.ssh ] && chmod 700 /root/.ssh && find /root/.ssh -type f ! -name \"*.pub\" ! -name known_hosts -exec chmod 600 {} +' || true\n\n# Optional hook: commit vps-data/startup.sh to reinstall apt packages, start services, etc.\nif [ -f \"$SRC/startup.sh\" ]; then\n  echo \"Running startup.sh\"\n  sudo bash \"$SRC/startup.sh\" || echo \"startup.sh exited non-zero\"\nfi\nEOF\n\nchmod +x /tmp/backup.sh /tmp/restore.sh\n"
            }
          }
        ]
